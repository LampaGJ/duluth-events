{
  "name": "duluth-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregates Duluth, MN events from heterogeneous sources (ICS feeds, HTML calendars, PDF brochures) into one normalized, provenance-tagged, subscribable ICS feed.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "pipeline": "tsx src/cli.ts",
    "build:feeds": "tsx src/build.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "places:osm": "node scripts/fetch-osm.mjs",
    "places:arcgis": "node scripts/fetch-arcgis.mjs",
    "places:overture": "tsx scripts/fetch-overture.mjs",
    "places:propose": "tsx scripts/places-propose.mjs",
    "trails:conditions": "tsx scripts/fetch-trailbot.mjs",
    "trails:join-propose": "tsx scripts/trailbot-join-propose.mjs",
    "aliases:harvest": "tsx scripts/harvest-aliases.mjs",
    "merge:diff": "tsx scripts/merge-diff.mjs"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "ical-generator": "^11.0.0",
    "node-ical": "^0.27.1",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
